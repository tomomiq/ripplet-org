{
  "name": "green-galaxy",
  "type": "module",
  "version": "0.0.1",
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "postbuild": "git diff --quiet src/lib/books-cache.json || git add src/lib/books-cache.json",
    "preview": "astro preview",
    "astro": "astro",
    "prepare": "husky",
    "generate-descriptions": "node scripts/generate-descriptions.mjs",
    "generate-descriptions:trips": "node scripts/generate-descriptions.mjs --dir trips",
    "generate-descriptions:all": "npm run generate-descriptions && npm run generate-descriptions:trips",
    "find-publisher-links": "node scripts/find-publisher-links.mjs",
    "sync-book-covers": "node --env-file=.env.local scripts/sync-book-covers.mjs",
    "validate-cache": "FORCE_VALIDATE=1 bash .husky/scripts/validate-books-cache.sh"
  },
  "dependencies": {
    "@astrojs/markdown-remark": "^7.2.2",
    "@astrojs/rss": "^4.0.18",
    "@astrojs/sitemap": "^3.7.2",
    "@astrojs/vercel": "^11.0.4",
    "@vercel/blob": "^2.6.1",
    "astro": "^7.1.6"
  },
  "devDependencies": {
    "@anthropic-ai/sdk": "^0.39.0",
    "husky": "^9.1.7"
  }
}
