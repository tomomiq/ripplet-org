---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Header from '../../components/Header.astro';
import WeeknotesEntry from '../../components/WeeknotesEntry.astro';
import NewsletterFooter from '../../components/NewsletterFooter.astro';
import { getCollection, render } from 'astro:content';
import { fetchBooks } from '../../lib/books';
import { fetchWeatherForPost } from '../../lib/weather';

export async function getStaticPaths() {
  const allPosts = await getCollection('weeknotes');
  const posts = allPosts.filter(p => !p.data.draft);
  posts.sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());

  return posts.map((post, i) => ({
    params: { slug: post.data.permalink.replace(/^\/weeknotes\//, '') },
    props: {
      post,
      prev: posts[i - 1] ?? null,
      next: posts[i + 1] ?? null,
    },
  }));
}

const { post, prev, next } = Astro.props;
const { Content } = await render(post);
const isbns = post.data.isbn
  ? (Array.isArray(post.data.isbn) ? post.data.isbn : [post.data.isbn]).filter(Boolean)
  : [];
const books = await fetchBooks(isbns);
const weather = post.data.location
  ? await fetchWeatherForPost(post.data.location, post.data.pubDate)
  : null;
---
<BaseLayout
  title={`${post.data.week} — ${post.data.title}`}
  rssUrl="/weeknotes/rss.xml"
  description={post.data.title || post.data.week}
  canonicalUrl={`https://www.ripplet.org${post.data.permalink}`}
  ogImage={post.data.image ? `https://www.ripplet.org/weeknotes-images/${post.data.image}` : undefined}
  articleDate={post.data.pubDate}
>
  <Fragment slot="head">
    <script type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "BlogPosting",
      "headline": `${post.data.week} — ${post.data.title}`,
      "url": `https://www.ripplet.org${post.data.permalink}`,
      "datePublished": post.data.pubDate.toISOString(),
      "author": { "@type": "Person", "name": "Tomomi Sasaki", "url": "https://www.ripplet.org" },
      ...(post.data.image && { "image": `https://www.ripplet.org/weeknotes-images/${post.data.image}` })
    })} />
  </Fragment>
  <Header currentPath="/weeknotes" />
  <main>
    <WeeknotesEntry post={post} Content={Content} books={books} weather={weather} />
    <nav class="pagination">
      {prev ? (
        <a href={prev.data.permalink} class="nav-card">
          {prev.data.image && <div class="nav-card-img" style={`background-image: url('/weeknotes-images/${prev.data.image}')`}></div>}
          <div class="nav-card-body">
            <div class="nav-card-label">← Previous week</div>
            <div class="nav-card-title">{prev.data.title}</div>
          </div>
        </a>
      ) : <span />}
      {next ? (
        <a href={next.data.permalink} class="nav-card is-next">
          {next.data.image && <div class="nav-card-img" style={`background-image: url('/weeknotes-images/${next.data.image}')`}></div>}
          <div class="nav-card-body">
            <div class="nav-card-label">Next week →</div>
            <div class="nav-card-title">{next.data.title}</div>
          </div>
        </a>
      ) : <span />}
    </nav>
    <div style="max-width: 720px; margin: 0 auto;">
      <NewsletterFooter />
    </div>
  </main>
</BaseLayout>

<style>
  .pagination {
    display: grid;
    grid-template-columns: 1fr 1fr;
    max-width: 780px;
    margin: 100px auto 80px;
    border-top: 1.5px solid #e0e0e0;
    border-bottom: 1.5px solid #e0e0e0;
  }

  .nav-card {
    display: flex;
    align-items: center;
    gap: 20px;
    text-decoration: none;
    padding: 24px 30px;
    transition: background 0.15s;
  }

  .nav-card:hover { background: #fafafa; opacity: 1; }

  .nav-card.is-next {
    flex-direction: row-reverse;
    border-left: 1.5px solid #e0e0e0;
  }

  .nav-card-img {
    width: 107px;
    height: 80px;
    flex-shrink: 0;
    background-size: cover;
    background-position: center;
  }

  .nav-card-body {
    display: flex;
    flex-direction: column;
    gap: 5px;
    min-width: 0;
  }

  .nav-card.is-next .nav-card-body { text-align: right; }

  .nav-card-label {
    font-size: 10px;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: #aaa;
    display: flex;
    align-items: center;
    gap: 5px;
  }

  .nav-card.is-next .nav-card-label { justify-content: flex-end; }

  .nav-card-title {
    font-size: 15px;
    font-weight: 600;
    line-height: 1.3;
    color: #222;
  }

  @media (max-width: 480px) {
    .pagination { grid-template-columns: 1fr; margin-top: 44px; }
    .nav-card.is-next { flex-direction: row; border-left: none; border-top: 1.5px solid #e0e0e0; }
    .nav-card.is-next .nav-card-body { text-align: left; }
    .nav-card.is-next .nav-card-label { justify-content: flex-start; }
  }
</style>
