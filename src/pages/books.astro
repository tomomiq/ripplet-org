---
export const prerender = false;
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import NewsletterFooter from '../components/NewsletterFooter.astro';
import booksCache from '../lib/books-cache.json';

type CacheEntry = {
  title?: string | null;
  author?: string | null;
  publisher?: string | null;
  year?: string | null;
  coverUrl?: string | null;
  infoUrl?: string | null;
  publisherUrl?: string;
  cachedAt: string;
  notFound?: true;
};

const books = Object.entries(booksCache as Record<string, CacheEntry>)
  .filter(([, v]) => !v.notFound)
  .sort((a, b) => new Date(b[1].cachedAt).valueOf() - new Date(a[1].cachedAt).valueOf())
  .map(([isbn, v]) => ({ isbn, ...v }));
---
<BaseLayout title="Books" description="Books I've been reading." canonicalUrl="https://www.ripplet.org/books">
  <Header currentPath="/books" />
  <main>
    <div class="page-header">
      <h1>Books</h1>
    </div>
    <div class="filters">
      <div class="filter-group">
        <span class="filter-label">Language</span>
        <div class="filter-pills" data-filter="lang">
          <button class="pill active" data-value="all">All</button>
          <button class="pill" data-value="en">English</button>
          <button class="pill" data-value="ja">Japanese</button>
        </div>
      </div>
      <div class="filter-group">
        <span class="filter-label">Type</span>
        <div class="filter-pills" data-filter="type">
          <button class="pill active" data-value="all">All</button>
          <button class="pill" data-value="fiction">Fiction</button>
          <button class="pill" data-value="nonfiction">Non-fiction</button>
        </div>
      </div>
      <div class="filter-group">
        <span class="filter-label">Year</span>
        <div class="filter-pills" data-filter="year">
          <button class="pill active" data-value="all">All</button>
          <button class="pill" data-value="recent">Last 4 weeks</button>
          <button class="pill" data-value="2026">2026</button>
          <button class="pill" data-value="2025">2025</button>
        </div>
      </div>
    </div>
    <div class="books-grid">
      {books.map(b => (
        <div class="book-card" data-lang={b.lang ?? ''} data-fiction={b.fiction === true ? 'fiction' : b.fiction === false ? 'nonfiction' : ''} data-cached-at={b.cachedAt}>
          <a href={b.publisherUrl || b.infoUrl || '#'} target="_blank" rel="noopener">
            {b.coverUrl
              ? <img class="book-cover" src={b.coverUrl} alt="" loading="lazy" />
              : <div class="book-cover-placeholder" />}
          </a>
          <div class="book-title">
            <a href={b.publisherUrl || b.infoUrl || '#'} target="_blank" rel="noopener">
              {b.title ?? '(unknown)'}
            </a>
          </div>
          {b.author && <div class="book-author">{b.author}</div>}
          <div class="book-added">Added {new Date(b.cachedAt).toLocaleDateString('en-US', { month: 'long', year: 'numeric' })}</div>
        </div>
      ))}
    </div>
  </main>
  <div class="footer-wrap">
    <NewsletterFooter />
  </div>
</BaseLayout>

<script>
  const cards = document.querySelectorAll<HTMLElement>('.book-card');

  function applyFilters() {
    const activeLang = document.querySelector<HTMLElement>('[data-filter="lang"] .pill.active')?.dataset.value ?? 'all';
    const activeType = document.querySelector<HTMLElement>('[data-filter="type"] .pill.active')?.dataset.value ?? 'all';
    const activeYear = document.querySelector<HTMLElement>('[data-filter="year"] .pill.active')?.dataset.value ?? 'all';
    const threeMonthsAgo = new Date(Date.now() - 28 * 24 * 60 * 60 * 1000);
    cards.forEach(card => {
      const langMatch = activeLang === 'all' || card.dataset.lang === activeLang;
      const typeMatch = activeType === 'all' || card.dataset.fiction === activeType;
      const cardDate = new Date(card.dataset.cachedAt ?? '');
      const yearMatch = activeYear === 'all'
        || (activeYear === 'recent' && cardDate >= threeMonthsAgo)
        || (cardDate.getFullYear().toString() === activeYear);
      card.style.display = langMatch && typeMatch && yearMatch ? '' : 'none';
    });
  }

  document.querySelectorAll<HTMLElement>('.filter-pills').forEach(group => {
    group.querySelectorAll('.pill').forEach(pill => {
      pill.addEventListener('click', () => {
        group.querySelectorAll('.pill').forEach(p => p.classList.remove('active'));
        pill.classList.add('active');
        applyFilters();
      });
    });
  });

  document.querySelectorAll<HTMLImageElement>('.book-cover').forEach(img => {
    const replace = () => {
      const p = document.createElement('div');
      p.className = 'book-cover-placeholder';
      img.replaceWith(p);
    };
    if (img.complete && img.naturalWidth === 0) replace();
    else img.addEventListener('error', replace);
  });
</script>

<style>
  .footer-wrap {
    max-width: 1100px;
    margin: 0 auto;
    padding: 0 30px;
  }

  main {
    max-width: 1100px;
    margin: 0 auto;
    padding: 0 30px 80px;
  }
  .page-header {
    max-width: 720px;
    margin: 0 auto 40px;
  }
  .page-header h1 {
    font-size: 28px;
    font-weight: 700;
    margin: 0;
    color: #111;
  }
  .books-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(160px, 1fr));
    gap: 28px 20px;
  }
  .book-card { display: flex; flex-direction: column; }
  .book-cover, .book-cover-placeholder {
    width: 100%;
    aspect-ratio: 2/3;
    margin-bottom: 10px;
  }
  .book-cover {
    object-fit: contain;
    display: block;
    background: #f5f5f5;
    border: 1px solid #e0e0e0;
    padding: 6px;
    box-sizing: border-box;
  }
  .book-cover-placeholder {
    background: #f5f5f5;
    border: 1px solid #e0e0e0;
    box-sizing: border-box;
    display: flex;
    align-items: center;
    justify-content: center;
  }
  .book-cover-placeholder::after { content: 'no cover'; font-size: 10px; color: #bbb; }
  .book-title { font-size: 13px; font-weight: 600; color: #111; line-height: 1.5em; margin-bottom: 2px; }
  .book-title a { color: inherit; text-decoration: none; }
  .book-title a:hover { text-decoration: underline; }
  .filters { display: flex; gap: 32px; margin-bottom: 32px; flex-wrap: wrap; }
  .filter-group { display: flex; align-items: center; gap: 10px; }
  .filter-label { font-size: 11px; text-transform: uppercase; letter-spacing: 0.8px; color: #999; }
  .filter-pills { display: flex; gap: 6px; }
  .pill {
    font-size: 12px;
    padding: 4px 12px;
    border-radius: 20px;
    border: 1px solid #e0e0e0;
    background: #fff;
    color: #555;
    cursor: pointer;
    font-family: inherit;
  }
  .pill:hover { border-color: #bbb; color: #111; }
  .pill.active { background: #111; border-color: #111; color: #fff; }

  .book-author { font-size: 12px; color: #666; line-height: 1.6; }
  .book-added { font-size: 11px; color: #aaa; line-height: 1.8; }

  @media (max-width: 768px) {
    main { padding: 0 20px 60px; }
    .books-grid { grid-template-columns: repeat(auto-fill, minmax(130px, 1fr)); gap: 24px 16px; }
  }
  @media (max-width: 480px) {
    main { padding: 0 16px 48px; }
    .books-grid { grid-template-columns: repeat(3, 1fr); gap: 20px 12px; }
  }
</style>
