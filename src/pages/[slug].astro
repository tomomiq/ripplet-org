---
import { getCollection, render } from 'astro:content';
import TripLayout from '../layouts/TripLayout.astro';
import EssayLayout from '../layouts/EssayLayout.astro';

export async function getStaticPaths() {
  const trips = await getCollection('trips', ({ data }) => !data.draft);
  const writing = await getCollection('writing', ({ data }) => !data.draft);

  const sortedTrips = [...trips].sort((a, b) => (b.data.year ?? 0) - (a.data.year ?? 0));
  const n = sortedTrips.length;
  const tripPaths = trips.map(trip => {
    const idx = sortedTrips.findIndex(t => t.id === trip.id);
    const morePeers = [
      sortedTrips[(idx + 1) % n],
      sortedTrips[(idx + 2) % n],
      sortedTrips[(idx - 1 + n) % n],
    ]
      .filter(t => t.id !== trip.id)
      .slice(0, 3)
      .map(t => ({
        title: t.data.title,
        permalink: `/${t.id.replace(/\.md$/, '')}`,
        thumbnail: t.data.thumbnail ?? null,
        year: t.data.year ?? null,
      }));
    return {
      params: { slug: trip.id.replace(/\.md$/, '') },
      props: { type: 'trip' as const, entry: trip, morePeers },
    };
  });

  const collectionOrder = ['project-craft', 'books', 'facilitation', 'studio-practice'];
  const allWritingSorted = collectionOrder.flatMap(col =>
    writing
      .filter(e => e.data.collection === col)
      .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf())
  );

  const writingPaths = allWritingSorted.map(entry => {
    const idx = allWritingSorted.findIndex(e => e.id === entry.id);
    const nextEntry = allWritingSorted[(idx + 1) % allWritingSorted.length];
    const prevEntry = allWritingSorted[(idx - 1 + allWritingSorted.length) % allWritingSorted.length];
    return {
      params: { slug: entry.data.permalink.replace(/^\//, '') },
      props: {
        type: 'writing' as const,
        entry,
        nextPeer: { title: nextEntry.data.title, permalink: nextEntry.data.permalink },
        prevPeer: { title: prevEntry.data.title, permalink: prevEntry.data.permalink },
      },
    };
  });

  return [...tripPaths, ...writingPaths];
}

const { type, entry, nextPeer, prevPeer, morePeers } = Astro.props;
const { Content } = await render(entry);
---

{type === 'trip' ? (
  <TripLayout
    title={entry.data.title}
    description={entry.data.description}
    canonicalUrl={entry.data.canonicalUrl}
    ogImage={entry.data.thumbnail ? `https://www.ripplet.org${entry.data.thumbnail}` : undefined}
    morePeers={morePeers ?? []}
  >
    <Content />
  </TripLayout>
) : (
  <EssayLayout
    title={entry.data.title}
    description={entry.data.description}
    collection={entry.data.collection}
    date={entry.data.date}
    permalink={entry.data.permalink}
    nextPeer={nextPeer}
    prevPeer={prevPeer}
  >
    <Content />
  </EssayLayout>
)}
