---
import BaseLayout from './BaseLayout.astro';
import Header from '../components/Header.astro';
import NewsletterFooter from '../components/NewsletterFooter.astro';

interface Props {
  title: string;
  description?: string;
  canonicalUrl?: string;
  ogImage?: string;
  morePeers?: Array<{ title: string; permalink: string; thumbnail?: string | null; year?: number | null }>;
}
const { title, description, canonicalUrl, ogImage, morePeers = [] } = Astro.props;
---
<BaseLayout
  title={title}
  description={description}
  canonicalUrl={canonicalUrl}
  ogImage={ogImage}
>
  <Header currentPath="/trips" />
  <main>
    <div class="trip-content">
      <slot />
    </div>
    {morePeers.length > 0 && (
      <section class="more-adventures">
        <div class="more-heading">More adventures</div>
        <nav class="more-grid">
          {morePeers.map(peer => (
            <a class="trip-block" href={peer.permalink}>
              {peer.thumbnail && <img src={peer.thumbnail} alt="" class="trip-thumb" />}
              <span class="trip-title">{peer.title}</span>
              {peer.year && <span class="trip-year">{peer.year}</span>}
            </a>
          ))}
        </nav>
      </section>
    )}
    <div class="trip-footer">
      <NewsletterFooter />
    </div>
  </main>
</BaseLayout>

<style>
  .trip-content {
    max-width: 960px;
    margin: 0 auto;
    padding: 40px 30px 0;
  }

  .trip-content :global(iframe) {
    display: block;
    width: 100%;
    margin: 1.5rem 0;
  }

  /* Image galleries */
  .trip-content :global(.image-grid .image-row) {
    display: contents;
  }

  .trip-content :global(.image-grid) {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
    gap: 20px;
    margin: 1.5rem 0;
  }

  .trip-content :global(.image-grid.cols-4) {
    grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
  }

  .trip-content :global(.image-grid img) {
    width: 100%;
    aspect-ratio: 1;
    object-fit: cover;
    margin: 0;
  }

  .trip-content :global(.image-grid > p) {
    display: none;
  }

  .trip-content :global(.image-grid figure) {
    margin: 0;
  }

  .trip-content :global(figcaption) {
    font-size: 12px;
    color: #999;
    margin-top: 4px;
  }

  /* Single images */
  .trip-content :global(figure:not(.image-grid figure)) {
    margin: 1rem 0;
  }

  .trip-content :global(figure:not(.image-grid figure) img) {
    max-width: 100%;
    height: auto;
    display: block;
  }

  /* Column layouts */
  .trip-content :global(.col-1-1) {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 2rem;
    align-items: start;
    margin: 1.5rem 0;
  }

  .trip-content :global(.col-2-1) {
    display: grid;
    grid-template-columns: 2fr 1fr;
    gap: 2rem;
    align-items: start;
    margin: 1.5rem 0;
  }

  .trip-content :global(.col-1-1 figure),
  .trip-content :global(.col-2-1 figure) {
    margin: 0;
  }

  .trip-content :global(.col-1-1 figure img),
  .trip-content :global(.col-2-1 figure img),
  .trip-content :global(.col-1-1 img),
  .trip-content :global(.col-2-1 img) {
    width: 100%;
    height: auto;
    display: block;
  }

  .trip-content :global(.col-1-1 > *:first-child),
  .trip-content :global(.col-2-1 > *:first-child) {
    margin-top: 0;
  }

  .trip-content :global(.col-1-1 > div > *:first-child),
  .trip-content :global(.col-2-1 > div > *:first-child) {
    margin-top: 0;
  }

  .trip-content :global(.col-1-1 iframe),
  .trip-content :global(.col-2-1 iframe) {
    margin: 0;
  }

  @media (max-width: 768px) {
    .trip-content :global(.col-1-1),
    .trip-content :global(.col-2-1) {
      grid-template-columns: 1fr;
    }
  }

  .more-adventures {
    max-width: 960px;
    margin: 80px auto 60px;
    padding: 28px 30px 0;
    border-top: 1.5px solid #e0e0e0;
  }

  .more-heading {
    font-size: 11px;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.12em;
    color: #aaa;
    margin: 0 0 20px;
  }

  .more-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 10px;
  }

  .trip-block {
    position: relative;
    display: block;
    text-decoration: none;
    overflow: hidden;
    aspect-ratio: 1;
  }

  .trip-block:hover { opacity: 0.8; }

  .trip-thumb {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  .trip-block::after {
    content: '';
    position: absolute;
    inset: 0;
    background: rgba(0,0,0,0.35);
  }

  .trip-year {
    position: absolute;
    bottom: 8px;
    right: 10px;
    z-index: 1;
    font-size: 10px;
    font-weight: 600;
    letter-spacing: 0.5px;
    color: #f0ece6;
  }

  .trip-title {
    position: absolute;
    inset: 0;
    z-index: 1;
    display: flex;
    align-items: center;
    justify-content: center;
    text-align: center;
    padding: 10px;
    font-size: 15px;
    font-weight: 500;
    letter-spacing: 0.04em;
    line-height: 1.3;
    color: #f0ece6;
  }

  .trip-footer {
    max-width: 960px;
    margin: 0 auto;
    padding: 0 30px;
  }

  @media (max-width: 480px) {
    .trip-content { padding: 20px 16px 0; }
    .more-adventures { padding: 24px 16px 0; margin-top: 44px; }
    .more-grid { grid-template-columns: repeat(2, 1fr); gap: 8px; }
    .trip-content :global(.image-grid) {
      grid-template-columns: repeat(2, 1fr);
    }
  }
</style>
